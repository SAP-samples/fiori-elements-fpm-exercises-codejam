{
  "name": "bookshop",
  "version": "1.0.0",
  "description": "A simple self-contained bookshop service.",
  "dependencies": {
    "@sap/cds": "^9"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9",
    "@cap-js/sqlite": "^2",
    "@sap/ux-specification": "~1.136",
    "cds-plugin-ui5": "^0"
  },
  "scripts": {
    "start": "cds run",
    "dev": "cds watch",
    "watch-bookshop-ui": "cds watch --open bookshopui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "db": {
      "kind": "sql"
    }
  },
  "sapux": [
    "app/bookshop-ui",
    "app/bookshop-ui"
  ],
  "workspaces": [
    "app/*"
  ]
}
